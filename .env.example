# Copie ce fichier en .env.local puis renseigne UN fournisseur.
# Sans aucune clé, l'application démarre en mode démonstration (sans IA, clairement signalé).
# Ces variables restent côté serveur : ne jamais les préfixer par NEXT_PUBLIC_.

# Forcer un fournisseur : cloudflare | openai | demo (facultatif, détection automatique sinon)
IMAGE_PROVIDER=

# --- Cloudflare Workers AI (offre gratuite avec quota quotidien) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Modèle de langue qui traduit les mots libres (« Autre… ») en anglais
# CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- OpenAI (payant) ---
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium

# Nombre maximal de générations par adresse IP sur 10 minutes (défaut : 12)
# RATE_LIMIT_PER_10_MIN=12
